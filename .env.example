# ============================================================================
# ADA - Configuracion de Entorno Reproducible (Plantilla sin secretos - Regla 4)
# Copia este archivo a .env si necesitas personalizar variables locales.
# ============================================================================

ADA_ENV=local
ADA_SEED=42

# --- Servidor Local Ollama (100% dentro del workspace en G:\ para no llenar C:\) ---
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODELS=./.ollama/models
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q4_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_CONTEXT_LENGTH=24576
OLLAMA_KEEP_ALIVE=30m
# Clave ficticia local requerida por algunos adaptadores OpenAI-compatibles (no sale de localhost)
OLLAMA_API_KEY=ollama-local

# --- Modelos Locales Libres por Rol en Ollama ---
# Caso 1: Ada Q (Cerebro Orquestador, Tool Calling, Datos, Estadistica y Canvas 60 FPS)
ADA_MODEL_ORCHESTRATOR=ada-q
# Caso 2: Ada r1 (Razonador Matematico / EDOs Pendulo / Critico Estadistico)
ADA_MODEL_REASONER=ada-r1

# --- DeepSeek Harness Home Aislado ---
DSH_HOME=./.dsh_home

# --- Respaldos API Opcionales (DESACTIVADOS por defecto; requieren aprobacion explicita) ---
ADA_ALLOW_EXTERNAL_API=false
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
